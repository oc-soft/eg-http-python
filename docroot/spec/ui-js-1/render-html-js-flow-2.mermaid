flowchart TD

  start0000@{shape: circle, label: "開始"}
  end9999@{shape: stadium, label: "終了"}

  dec1000@{shape: diamond, label: "Acceptはapplication/json?"}
  proc1000@{shape: rect, label: "jsonによる応答"}
  proc2000@{shape: rect, label: "htmlによる応答"}

  start0000 --> dec1000
  dec1000 -- Yes --> proc1000
  dec1000 -- No --> proc2000
  proc1000 --> end9999
  proc2000 --> end9999
